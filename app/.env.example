# Amber Systems Portfolio - Environment Variables
# Copy this file to .env.local and fill in your values

# Email Service Configuration
# Choose ONE of the following email services:

# Option 1: Resend (Recommended)
# Sign up at https://resend.com
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Option 2: SendGrid (Alternative)
# Sign up at https://sendgrid.com
# Get your API key from https://app.sendgrid.com/settings/api_keys
# SENDGRID_API_KEY=SG.your_api_key_here

# Option 3: SMTP (Generic)
# Use any SMTP server (Gmail, Outlook, custom server)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Contact Form Settings
# Email address where contact form submissions will be sent
CONTACT_EMAIL=isaiahamber5@gmail.com

# Optional: Analytics & Monitoring
# VERCEL_ANALYTICS_ID=your_analytics_id
# SENTRY_DSN=your_sentry_dsn

# ── Assistant (api/chat.ts) ───────────────────────────────────────────────
# The Talk window's chat. Without a key the endpoint returns a polite 503 and
# the contact form still works, so the site degrades rather than breaks.

# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# Optional. Any model slug OpenRouter accepts.
# OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Optional. Sent to OpenRouter for attribution.
# SITE_URL=https://your-domain.com
